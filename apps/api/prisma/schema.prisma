generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Allowed lifecycle states for a Transaction.
enum TransactionStatus {
  PENDING
  RETRYING
  SUCCESS
  FAILED
  /// Transaction passed the fraud check but scored in the medium-risk band
  /// (0.5 ≤ riskScore < 0.8) and is held for manual review before submission.
  PENDING_REVIEW
}

/// Allowed lifecycle states for KYC records.
enum KycStatus {
  PENDING
  APPROVED
  REJECTED
}

/// KYC verification tiers.
enum KycTier {
  NONE
  BASIC
  FULL
}

enum UserRole {
  USER
  ADMIN
}

/// Compliance action kinds supported on regulated corridors.
enum ComplianceActionType {
  /// Freeze a target's trustline via SetTrustLineFlags (clears AUTHORIZED_FLAG).
  FREEZE
  /// Claw back illicit funds from a target account back to the issuer treasury.
  CLAWBACK
}

/// Lifecycle states for a compliance action.
enum ComplianceActionStatus {
  /// Created by one officer; awaiting a second officer's approval.
  PENDING_APPROVAL
  /// Approved by the required number of distinct compliance officers.
  APPROVED
  /// Dispatched to the Rust worker for on-chain execution.
  EXECUTING
  /// Executed on-chain; txHash populated.
  EXECUTED
  /// Execution failed on-chain or the worker reported a failure.
  FAILED
  /// Rejected by an officer before reaching the approval threshold.
  REJECTED
}

model User {
  id           String        @id @default(uuid())
  email        String        @unique
  password     String
  name         String?
  role         UserRole      @default(USER)
  erasedAt     DateTime?
  createdAt    DateTime      @default(now())
  wallet       Wallet?
  transactions Transaction[]
  kyc          KycRecord?
}

/// Non-reversible lookup record used to make erasure idempotent after the
/// original user identifier has been replaced. Never store the original ID.
model AnonymizationTombstone {
  id                  String   @id @default(uuid())
  originalUserIdHash  String   @unique
  pseudonymousUserId  String   @unique
  erasedAt            DateTime @default(now())

  @@index([erasedAt])
}

/// A compliance action (freeze or clawback) initiated by an admin officer on a
/// regulated corridor. Requires at least two distinct officers to approve
/// before the action is dispatched to the Rust worker for on-chain execution.
model ComplianceAction {
  id            String                 @id @default(uuid())
  type          ComplianceActionType
  status        ComplianceActionStatus @default(PENDING_APPROVAL)
  /// Stellar public key of the account being frozen or clawed back.
  targetAccount String
  /// Asset code involved (e.g. "USDC", "NGN").
  assetCode     String
  /// Asset issuer public key; null for native XLM.
  assetIssuer   String?
  /// Amount to claw back (string to preserve decimal precision). Null for freeze actions.
  amount        String?
  /// Free-text justification recorded for the audit trail.
  reason        String?
  /// Compliance officer (admin user) who initiated the action — also the first approver.
  requestedBy   String
  /// Stellar transaction hash once executed on-chain.
  txHash        String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  approvals ComplianceApproval[]

  @@index([status])
  @@index([targetAccount])
  @@index([requestedBy])
  @@index([createdAt])
}

/// A single officer's approval of a compliance action, carrying a SHA-256
/// signature over the canonical action payload. At most one approval per
/// officer per action (enforced by @@unique([actionId, officerId])).
model ComplianceApproval {
  id         String   @id @default(uuid())
  actionId   String
  /// Compliance officer (admin user) who approved.
  officerId  String
  /// SHA-256 signature binding the officer to the action payload.
  signature  String
  approvedAt DateTime @default(now())

  action ComplianceAction @relation(fields: [actionId], references: [id], onDelete: Cascade)

  @@unique([actionId, officerId])
  @@index([actionId])
}

model Wallet {
  id              String        @id @default(uuid())
  /// Foreign key to the owning User. One wallet per user (enforced by @unique).
  userId          String        @unique
  /// Stellar public key – must be globally unique.
  publicKey       String        @unique
  encryptedSecret String
  encryptedDek    String?
  kmsKeyId        String?
  createdAt       DateTime      @default(now())
  /// Automatically updated whenever the wallet record changes (e.g. key rotation).
  updatedAt       DateTime      @updatedAt
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions    Transaction[]
}

model Transaction {
  id             String            @id @default(uuid())
  /// Foreign key to the User who initiated this transaction.
  userId         String
  /// Foreign key to the Wallet used for this transaction.
  walletId       String
  /// Stellar destination public key – required, never null.
  destination    String
  /// Transfer amount as a string to preserve decimal precision – required.
  amount         String
  /// Stellar asset code (e.g. "XLM", "USDC") – required.
  assetCode      String
  /// Asset issuer account; null for native XLM.
  assetIssuer    String?
  /// Optional transaction memo.
  memo           String?
  /// Client-supplied idempotency key (UUID) from the `Idempotency-Key` header
  /// on POST /transactions/send. Null when the client omits the header.
  idempotencyKey String?
  /// Lifecycle state of this transaction.
  status         TransactionStatus @default(PENDING)
  /// Stellar transaction hash once submitted; unique across all confirmed txs.
  stellarTxHash  String?           @unique
  /// Fraud risk score from the analytics service.
  riskScore      Float?
  /// Whether this transaction has been flagged for review.
  flagged        Boolean           @default(false)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Restrict)

  /// Guarantees at most one transaction per (user, idempotency key), so a
  /// retried POST /transactions/send cannot create a duplicate transfer.
  /// Postgres treats NULLs as distinct, so transactions without a key (the
  /// header is optional) are unaffected.
  @@unique([userId, idempotencyKey])
  /// Speeds up per-user history queries (ordered by newest first).
  @@index([userId, createdAt(sort: Desc)])
  /// Speeds up per-wallet history queries.
  @@index([walletId, createdAt(sort: Desc)])
}

model KycRecord {
  id              String        @id @default(uuid())
  userId          String        @unique
  status          KycStatus     @default(PENDING)
  tier            KycTier       @default(NONE)
  documentType    String?
  /// SHA-256 hex digest of the uploaded document, prefixed with the S3 object
  /// key: "<s3-key>:<sha256-hex>". Set by POST /kyc/confirm-upload after hash
  /// verification. Null until the upload is confirmed.
  documentRef     String?
  submittedAt     DateTime?
  reviewedAt      DateTime?
  rejectionReason String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
}

/// Structured audit log entry capturing security-relevant events.
/// Each row is immutable by convention — never UPDATE or DELETE audit rows.
/// Rows form a tamper-evident SHA-256 hash chain: every entry stores the hash
/// of the previous entry (`previousHash`) plus its own `hash`, so retroactive
/// modification of any row breaks the chain.
model AuditLog {
  id            String   @id @default(uuid())
  /// The authenticated user who triggered the event (nullable for system events).
  userId        String?
  /// High-level event category: WALLET | TRANSACTION | AUTH | COMPLIANCE | KYC
  category      String
  /// Specific operation: WALLET_CREATED | WALLET_EXPORTED | WALLET_IMPORTED |
  ///   TX_SUBMITTED | TX_SUCCESS | TX_FAILED | TX_RETRYING |
  ///   COMPLIANCE_FREEZE_REQUESTED | COMPLIANCE_CLAWBACK_REQUESTED | …
  operation     String
  /// Outcome of the operation: SUCCESS | FAILURE
  outcome       String
  /// Stellar public key involved, when applicable.
  walletPublicKey String?
  /// Transaction amount, when applicable.
  amount        String?
  /// Asset code (XLM, USDC, …), when applicable.
  assetCode     String?
  /// Destination Stellar address, when applicable.
  destination   String?
  /// Stellar transaction hash, when applicable.
  txHash        String?
  /// Additional freeform context serialised as JSON.
  metadata      Json?
  /// SHA-256 (hex) of the immediately preceding audit entry, forming the hash chain.
  previousHash  String?
  /// SHA-256 (hex) over this entry's canonical payload + previousHash.
  hash          String?
  /// ISO-8601 timestamp — indexed for time-range queries during reviews.
  createdAt     DateTime @default(now())

  @@index([userId])
  @@index([category])
  @@index([operation])
  @@index([createdAt])
  @@index([previousHash])
}
